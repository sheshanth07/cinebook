# ============================================================================
# CineBook Configuration Settings (.env.example)
# Copy this file to .env or cinebook.conf
# ============================================================================

# Web Server Settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Database Engine Selection: 'oracle' or 'local'
# Default: 'local' (runs embedded SQL engine cinebook.db without external Oracle install)
# Set to 'oracle' when connected to an Oracle 12c/19c/21c/XE database with OCCI
DB_ENGINE=local

# Oracle Database Connection Settings (When DB_ENGINE=oracle)
ORACLE_USER=cinebook
ORACLE_PASSWORD=cinebook_secret
ORACLE_CONNECT_STRING=localhost:1521/XEPDB1

# Local Persistent Database Path (When DB_ENGINE=local)
LOCAL_DB_PATH=cinebook.db

# Security & Admin Authorization Token
ADMIN_AUTH_TOKEN=cinebook_admin_secure_key_2026
